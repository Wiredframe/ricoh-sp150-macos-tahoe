#!/bin/bash
# pdftoricoh - CUPS filter wrapper for the RICOH SP 150 on macOS 26/27.
#
# Apple removed cgpdftoraster in macOS 26, and Ricoh's own filter is x86_64 only
# (dead on Apple Silicon without Rosetta 2). This wrapper restores the chain with
# two native binaries that use only Apple system frameworks and libcups:
#
#   PDF --(pdftoraster_cg, CoreGraphics)--> CUPS raster
#       --(rastertolhpl, JBIG1 + PJL)--> RICOH LHPL print stream
#
# CUPS invokes filters as:  filter job user title copies options [filename]

set -o pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"

"$DIR/pdftoraster_cg" "$@" | "$DIR/rastertolhpl" "$1" "$2" "$3" "$4" "$5"
exit "${PIPESTATUS[1]}"
